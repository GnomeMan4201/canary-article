+    def reschedule(self, booking_id, start, end):
+        if not isinstance(booking_id, str) or not booking_id:
+            raise ValueError("INVALID_INPUT")
+        if booking_id not in self._bookings:
+            raise ValueError("BOOKING_NOT_FOUND")
+        start, end = _normalize_interval(start, end)
+        normalized = dict(self._bookings[booking_id], start=start, end=end)
+        if self._has_conflict(normalized, exclude_id=booking_id):
+            raise ValueError("CONFLICT")
+        self._bookings[booking_id] = normalized
+        return dict(normalized)
