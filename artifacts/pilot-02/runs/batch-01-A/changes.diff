+    def book_many(self, records):
+        """Add a list of bookings atomically, returning them in input order."""
+        if not isinstance(records, list):
+            raise ValueError("INVALID_INPUT")
+        # book() only adds records, so existing records can be shared safely
+        # while a separate mapping stages the batch for validation.
+        staged = BookingStore()
+        staged._bookings = self._bookings.copy()
+        results = [staged.book(record) for record in records]
+        self._bookings = staged._bookings
+        return results
